# ============================================================
# VIBECART ENVIRONMENT CONFIGURATION
# ============================================================

# Database
MONGODB_URI=mongodb://localhost:27017/vibecart

# JWT Secrets
JWT_SECRET=vibecart_super_secret_jwt_key_2026_secure
JWT_REFRESH_SECRET=vibecart_refresh_super_secret_key_2026_secure
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:5000/api
BACKEND_URL=http://127.0.0.1:5000

# Payment Gateway Configuration
PAYMENT_PROVIDER_KEY=vibecart_pay_test_key_999
PAYMENT_PROVIDER_SECRET=vibecart_pay_test_secret_999

# Ports & URLs
PORT=5000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
